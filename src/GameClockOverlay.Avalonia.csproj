<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>15.0</LangVersion><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <!-- RTSS Shared Memory：沿用 RTSS-1 原型的指標存取（僅限 Services/Rtss/SharedOsd.cs）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers><AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit>
    <!-- v0.3.0：與 WPF v0.2.0 相同的版本欄位寫法；不把原始碼修訂附加到資訊版本。 -->
    <Version>0.3.0</Version><AssemblyVersion>0.3.0.0</AssemblyVersion><FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>GameClock Overlay</Product><AssemblyTitle>GameClock Overlay</AssemblyTitle><Authors>Kaido-MSVC</Authors>
    <Copyright>Copyright (c) 2026 Kaido-MSVC; GameClock Overlay contributors</Copyright>
    <ApplicationIcon>clock.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <AvaloniaResource Include="clock.ico" />
    <None Include="../LICENSE;../THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
