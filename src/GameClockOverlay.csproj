<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>GameClockOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>clock.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <Authors>Kaido-MSVC</Authors>
    <Copyright>Copyright (c) 2026 Kaido-MSVC; GameClock Overlay contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../LICENSE" LogicalName="GameClockOverlay.LICENSE" />
    <EmbeddedResource Include="../THIRD-PARTY-NOTICES.txt" LogicalName="GameClockOverlay.THIRD-PARTY-NOTICES" />
    <EmbeddedResource Include="../licenses/*.txt" LogicalName="GameClockOverlay.licenses.%(Filename)%(Extension)" />
    <None Include="../LICENSE;../README.md;../THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
